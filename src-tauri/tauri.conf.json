{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Dockspan",
  "version": "0.1.0",
  "identifier": "app.dockspan.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      { "title": "Dockspan", "width": 1440, "height": 900, "minWidth": 900, "minHeight": 600, "backgroundColor": "#0E1014" }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
